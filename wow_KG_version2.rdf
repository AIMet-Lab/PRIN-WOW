        <dbo:firstPublisher>Piemme</dbo:firstPublisher>
        <dcterms:title>Una donna lo sa. Storie di figlie, sorelle e madri</dcterms:title>
        <schema:creativeWorkStatus>in commercio</schema:creativeWorkStatus>
        <schema:datePublished rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2014</schema:datePublished>
